# Backend Environment Variables
# Copy to .env and fill in values

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrimitra?schema=public"

# JWT
JWT_SECRET="agrimitra-dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# OTP (future — not used in dev)
# OTP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# AI Service (future — not used in v1, all stubbed)
# AI_SERVICE_URL=
# AI_SERVICE_API_KEY=
